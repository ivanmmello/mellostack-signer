# Credenciais PSC — copie para .env na raiz de apps/ ou exporte no shell.
# Nunca commite valores reais.

PSC_PROVIDER=birdid
PSC_ENVIRONMENT=homologation
PSC_CLIENT_ID=
PSC_CLIENT_SECRET=
PSC_CERTIFICATE_ALIAS=
PSC_API_BASE_URL=

# OAuth callback (deve estar cadastrado no PSC)
DEMO_OAUTH_REDIRECT_URI=http://localhost:8096/api/v1/oauth/callback
DEMO_FRONTEND_URL=http://localhost:5173

# PAdES-T (opcional)
ACT_TSA_URL=
